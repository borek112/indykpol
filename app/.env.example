# ── Backend ─────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_API_URL=             # Public backend tRPC URL, ending with /api/trpc

# ── Backend (Auth) ─────────────────────────────────────────────
NODE_ENV=development      # Set production on Railway/Render
FRONTEND_URL=             # Netlify URL, e.g. https://your-site.netlify.app
CORS_ORIGIN=              # Optional alias for FRONTEND_URL
SESSION_SECRET=           # Required in production; long random server-only secret
DEMO_MODE=false           # Set true only for a public demo backend
DEMO_COMPANY_ID=          # Existing demo company ID, required when DEMO_MODE=true
VITE_DEMO_MODE=false      # Netlify build flag; must match Railway DEMO_MODE
